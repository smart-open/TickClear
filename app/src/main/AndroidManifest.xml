<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 手电筒工具：CameraManager.setTorchMode 需 CAMERA 权限（危险权限，运行时申请）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      精确闹钟权限（提醒「到点必响」的前提）：
      - Android 12(31)~12L(32)：SCHEDULE_EXACT_ALARM，需用户在系统设置中手动授予；
      - Android 13(33)+：USE_EXACT_ALARM，安装即授予、无需用户操作。
      本 App 核心功能为「定时任务 / 习惯提醒」（闹钟类），符合 USE_EXACT_ALARM 适用范围；
      两者按官方推荐组合声明（SCHEDULE_EXACT_ALARM 限制在 32 及以下，避免与前者冲突）。
      ⚠️ Android 14 起 SCHEDULE_EXACT_ALARM 对新装应用默认「拒绝」，若缺 USE_EXACT_ALARM，
      setAlarmClock / setExactAndAllowWhileIdle 会抛 SecurityException 直接闪退。
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- V2.9++ 悬浮时钟：specialUse 前台服务类型（targetSdk 34+ 强制要求配套权限，否则 startForeground 抛 SecurityException）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- V2.9++ 悬浮时钟：显示在其他应用上层（特殊权限，需经系统设置页授权，非运行时权限）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      设备兼容性声明（必须显式 required="false"）：
      RECORD_AUDIO 会隐式带来 android.hardware.microphone required="true"，
      ACCESS_FINE_LOCATION 会隐式带来 android.hardware.location[.gps] required="true"，
      应用市场据此过滤设备 —— 无 GPS 的平板等机型会被挡在安装门外。
      本 App 核心是纯本地待办清单，语音助手与位置提醒都是可选增强，
      缺少对应硬件时功能自动降级（见设置页各开关的可用性判断），不应影响安装。
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <!-- 手电筒依赖相机闪光灯，但属可选增强，缺硬件时功能降级（见工具页提示），不应影响安装。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".TickClearApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TickClear"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TickClear"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            全屏提醒页：必须能在锁屏之上直接亮屏展示，否则高优先级提醒在锁屏态只剩一条通知。
            showWhenLocked/turnScreenOn 为 API 27+ 的清单等价物（代码侧另有 API 27+ 的运行时调用兜底）；
            excludeFromRecents 避免提醒页残留在最近任务里被误点。
        -->
        <activity
            android:name=".FullScreenAlertActivity"
            android:exported="false"
            android:theme="@style/Theme.TickClear"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <receiver
            android:name=".domain.scheduler.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 覆盖安装会清空本应用全部 AlarmManager 闹钟，必须重排 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 跨时区 / 手动改系统时间会让 RTC 闹钟整体漂移，同样需要重排 -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".domain.backup.AutoBackupReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- V2.8 桌面小组件：框架 AppWidgetProvider + RemoteViewsService（零新依赖，不引入 androidx.glance） -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <service
            android:name=".widget.TodayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".domain.scheduler.RecycleBinPurgeReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".domain.scheduler.ReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- V2.9 工具箱间隔提醒（喝水 / 休息）：由本应用 AlarmManager 闹钟自调度触发 -->
        <receiver
            android:name=".domain.scheduler.IntervalReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- V2.9++ 午休小憩：一次性精确闹钟触发 -->
        <receiver
            android:name=".domain.scheduler.NapReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- V2.9++ 到期提醒：一次性精确闹钟触发 -->
        <receiver
            android:name=".domain.scheduler.ExpiryReceiver"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".domain.scheduler.HabitReminderReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- V2.13 位置提醒前台轮询服务：零 GMS 依赖，仅后台监测到达提醒时运行 -->
        <service
            android:name=".domain.scheduler.LocationReminderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- V2.66 常驻语音唤醒前台服务：能量级 VAD（AudioRecord 原生麦克风），零新依赖 -->
        <service
            android:name=".domain.assistant.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- V2.9++ 悬浮时钟：TYPE_APPLICATION_OVERLAY 常驻前台服务（specialUse 兜底类型）。 -->
        <service
            android:name=".ui.tools.ClockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.service.foregroundServiceType"
                android:value="specialUse" />
        </service>

        <!-- V2.8X 打卡分享卡：将本地生成的 PNG 经 FileProvider 授权给分享目标 App 读取（零新依赖，androidx.core 已含）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tickclear.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
